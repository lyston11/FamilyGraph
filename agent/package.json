{
  "name": "@familygraph/agent-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "FamilyGraph Node Pi sidecar: executes agent runs against the FastAPI internal tool protocol. No DB, no filesystem tools, no arbitrary egress.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest --run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
