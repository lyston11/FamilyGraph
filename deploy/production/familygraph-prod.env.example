# FamilyGraph 线上环境变量模板（fg.lyston.qzz.io）
#
# 部署位置（服务器）：~/.config/familygraph/familygraph-prod.env
# 权限：0600，属主为运行部署的用户。该文件不进入仓库、不进日志、不写入任务文件。
#
# 用法：
#   cp deploy/production/familygraph-prod.env.example \
#      ~/.config/familygraph/familygraph-prod.env
#   # 三个密钥必须换成全新随机值（不要沿用开发环境的）：
#   #   openssl rand -hex 32
#   chmod 600 ~/.config/familygraph/familygraph-prod.env
#
# 隔离要求（prd.md R2）：SECRET_KEY / AGENT_SERVICE_SECRET / ADMIN_JWT_SECRET
# 必须与开发环境 ~/.config/familygraph/familygraph.env 的值**不同**。
# 相同即意味着两侧 JWT 可互相验签、Provider 密钥密文可互相解密，隔离失效。

# ---- 必填密钥（compose 层 fail-closed：缺失即拒绝启动）----
# 三个值都必须重新生成，不得从开发环境复制。
SECRET_KEY=
AGENT_SERVICE_SECRET=
ADMIN_JWT_SECRET=

# ---- 管理员 JWT 签发域（与开发同构；值本身不是密钥）----
ADMIN_JWT_ISSUER=familygraph:admin-api
ADMIN_JWT_AUDIENCE=familygraph:admin-web

# ---- 系统管理员初始密码 ----
# 部署指定的初始/恢复密码；留空则随机生成并写入 0600 凭据文件。
# 首登强制改密；正常重启不重置既有账号。
ADMIN_INITIAL_PASSWORD=

# ---- 功能开关（与开发环境保持一致，prd.md R9）----
AGENT_RUNTIME_ENABLED=1
PERSONAL_FAMILY_VIEW_ENABLED=1
STEWARD_ENABLED=1
STEWARD_WORKER_ENABLED=1
STEWARD_ASSIST_CANDIDATE=1
STEWARD_ASSIST_RANKING=1
STEWARD_ASSIST_EXPLANATION=1
STEWARD_ASSIST_TERMINOLOGY=1
STEWARD_ASSIST_TIMEOUT_SECONDS=60
MEMORY_ENABLED=1
RAG_ENABLED=1

# ---- Steward 调度（与开发同构）----
MAINTENANCE_INTERVAL_SECONDS=5
STEWARD_SCAN_INTERVAL_SECONDS=1800

# ---- 演示种子数据（prd.md R7：朱元璋等 51 个 mock 账号可登录）----
# 首启在空库上 insert-only 播种「明皇室 + 九户外戚世家」；
# 重复启动只补缺、不改动既有行。
DEV_SEED_DEMO_DATA=1

# ---- 保持默认关闭（与开发一致）----
# RELATIONSHIP_INTELLIGENCE_ENABLED=0
# CONTROLLED_WEB_ENABLED=0
# STEWARD_ALERT_QUEUE_SECONDS=0
# DEV_ALLOW_WEAK_SECRETS=0

# 说明：FG_API_BASE_URL / FG_INTERNAL_API_BASE_URL / INTERNAL_AGENT_API_HOST /
# ADMIN_API_HOST 由 docker-compose.yml 按容器网络静态分配，不需要在此设置。
